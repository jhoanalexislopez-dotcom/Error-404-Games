  - m_Id: 578363858944
    m_Localized: "What time is it?\r"
    m_Metadata:
      m_Items: []
  - m_Id: 719032426496
    m_Localized: "...Mara, moving around in the dark again?\r"
    m_Metadata:
      m_Items: []
  - m_Id: 802201280512
    m_Localized: 'Mara? Where are you? What...?

'
    m_Metadata:
      m_Items: []
  - m_Id: 887240794112
    m_Localized: 'She''s outside... Alone in the woods?

'
    m_Metadata:
      m_Items: []
  - m_Id: 968606097408
    m_Localized: '...All right. I''m on my way.

'
    m_Metadata:
      m_Items: []
