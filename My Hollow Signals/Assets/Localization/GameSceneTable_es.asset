  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 490354778112
    m_Localized: Abrir
    m_Metadata:
      m_Items: []
  - m_Id: 578363858944
    m_Localized: "\xBFQu\xE9 hora es?\r"
    m_Metadata:
      m_Items: []
  - m_Id: 719032426496
    m_Localized: "...Mara \xBFOtra vez movi\xE9ndose a oscuras?\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 802201280512
    m_Localized: "\xBFMara? \xBFD\xF3nde est\xE1s? \xBFQu\xE9...?\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 887240794112
    m_Localized: "Est\xE1 fuera... \xBFSola en el bosque?\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 968606097408
    m_Localized: '...Vale. Estoy yendo.

'
    m_Metadata:
      m_Items: []
  - m_Id: 38149299363840
    m_Localized: Recargar
    m_Metadata:
      m_Items: []
  - m_Id: 36778294632448
    m_Localized: Recoger
    m_Metadata:
      m_Items: []
  - m_Id: 1290242105344
    m_Localized: Pausa
    m_Metadata:
      m_Items: []
  - m_Id: 1370059710464
    m_Localized: Reanudar
    m_Metadata:
      m_Items: []
  - m_Id: 1434375168000
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 2168210595840
    m_Localized: "Rat\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 2243531907072
    m_Localized: Mando
    m_Metadata:
      m_Items: []
  - m_Id: 44472447524864
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 45900792586240
    m_Localized: "Silas\u2026 ay\xFAdame\u2026 bosque\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 46268440109056
    m_Localized: "Por favor... Ven a la caba\xF1a yendo hacia el norte..."
    m_Metadata:
      m_Items: []
  - m_Id: 47891015000064
    m_Localized: Mara
    m_Metadata:
      m_Items: []
  - m_Id: 49094574727168
    m_Localized: "(Esta puerta... \xBFest\xE1 cerrada?)"
    m_Metadata:
      m_Items: []
  - m_Id: 49548490694656
    m_Localized: Hoy
    m_Metadata:
      m_Items: []
  - m_Id: 51163360649216
    m_Localized: 1 Mensaje nuevo
    m_Metadata:
      m_Items: []
  - m_Id: 51361101111296
    m_Localized: MENSAJES
    m_Metadata:
      m_Items: []
  - m_Id: 206804678479872
    m_Localized: " Mara\u2026 si est\xE1s aqu\xED\u2026 dame una se\xF1al."
    m_Metadata:
      m_Items: []
  - m_Id: 217826734772224
    m_Localized: Nada.
    m_Metadata:
      m_Items: []
  - m_Id: 218138795184128
    m_Localized: " La cueva\u2026 \xBFqu\xE9 est\xE1s haciendo, Mara?"
    m_Metadata:
      m_Items: []
  - m_Id: 218746474336256
    m_Localized: Tengo que seguirla.
    m_Metadata:
      m_Items: []
  - m_Id: 254023846727680
    m_Localized: "Por favor, que est\xE9s bien\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 254311936692224
    m_Localized: "Fogata\u2026 la fogata. Ella habl\xF3 de eso antes. Tengo que llegar
      ah\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 254815790043136
    m_Localized: "Quiere que vuelva\u2026 \xBFpor qu\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 419830011256832
    m_Localized: "\u2026\xBFQu\xE9 ha pasado aqu\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 420081103265792
    m_Localized: "\xBFEso\u2026 viene de arriba?"
    m_Metadata:
      m_Items: []
  - m_Id: 420281037348864
    m_Localized: " Mara\u2026 \xBFest\xE1s ah\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 420405989859328
    m_Localized: " No\u2026 no\u2026 Mara\u2026 \xA1no!"
    m_Metadata:
      m_Items: []
  - m_Id: 606027160883200
    m_Localized: "\xC9l..."
    m_Metadata:
      m_Items: []
  - m_Id: 606148724396032
    m_Localized: "\xBFQui\xE9n es \"\xE9l\"...?"
    m_Metadata:
      m_Items: []
  - m_Id: 629158852300800
    m_Localized: "Nota encontrada en la caba\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 629468895252480
    m_Localized: "No quiero que sufras, por eso\r\nte alej\xE9 de m\xED.\nNunca lo
      entender\xE1s,\r\npero este poder es m\xEDo, siempre lo ha sido.\r\nCuando
      llegue el momento, tendr\xE1s que elegir:\r\nseguirme... o desaparecer."
    m_Metadata:
      m_Items: []
  - m_Id: 629451044294656
    m_Localized: Nota encontrada en la cueva
    m_Metadata:
      m_Items: []
  - m_Id: 629488889499648
    m_Localized: Nota encontrada en la fogata
    m_Metadata:
      m_Items: []
  - m_Id: 629111947399168
    m_Localized: "Las voces no se detienen...\r\nDicen que debo encontrar algo, que
      solo\r\nentonces todo terminar\xE1.\r\nSi me encuentras, no te acerques.\r\nYa
      no soy el mismo."
    m_Metadata:
      m_Items: []
  - m_Id: 629426948018176
    m_Localized: "He visto cosas que t\xFA no entender\xEDas.\nMe observan, me gu\xEDan,
      \r\nme muestran la verdad.\r\nSiempre has sido d\xE9bil, pero yo...\r\nEstoy
      aprendiendo a ser fuerte.\r\nPronto lo entender\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 634508829659136
    m_Localized: Linterna
    m_Metadata:
      m_Items: []
  - m_Id: 634707073437696
    m_Localized: Pulsa Interactuar para leer
    m_Metadata:
      m_Items: []
  - m_Id: 1052137399246848
    m_Localized: "(Est\xE1 oscuro afuera, necesito una linterna...)"
    m_Metadata:
      m_Items: []
  - m_Id: 1100389322579968
    m_Localized: Mover
    m_Metadata:
      m_Items: []
  - m_Id: 1176303356076032
    m_Localized: "(Me estoy cansando... Deber\xEDa seguir el camino)"
    m_Metadata:
      m_Items: []
  - m_Id: 5153001684590592
    m_Localized: Pulsa T (o arriba en la cruceta) para ver tus mensajes
    m_Metadata:
      m_Items: []
  - m_Id: 5154230833766400
    m_Localized: Pulsa F (o X) para abrir el inventario
    m_Metadata:
      m_Items: []
  - m_Id: 5156029573619712
    m_Localized: "Puedes correr (Shift o L3) pero har\xE1s m\xE1s ruido"
    m_Metadata:
      m_Items: []
  - m_Id: 5158819461062656
    m_Localized: "Deber\xEDa volver a casa, a lo mejor est\xE1 all\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 6269547878277120
    m_Localized: Cerrar
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
