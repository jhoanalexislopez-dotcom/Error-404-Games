  m_Name: FirstSceneTable_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 2d79eebcfc96f414e9609c2c18ae53bf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 109973348352
    m_Localized: Espacio
    m_Metadata:
      m_Items: []
  - m_Id: 2655215427584
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 2726715727872
    m_Localized: Dicen que los lazos de sangre nunca se rompen... pero el nuestro
      siempre fue distinto.
    m_Metadata:
      m_Items: []
  - m_Id: 2862632148992
    m_Localized: "Mi hermana naci\xF3 sin poder ver el mundo, y sin embargo siempre
      parec\xEDa entenderlo mejor que yo."
    m_Metadata:
      m_Items: []
  - m_Id: 3133424803840
    m_Localized: "Ella era la \xFAnica que pod\xEDa calmarme en mis peores momentos,
      la \xFAnica que hablaba de cosas que no pod\xEDa ver, pero que describ\xEDa
      como si estuvieran all\xED mismo.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 3307396145152
    m_Localized: "Con el paso de los a\xF1os, sus palabras comenzaron a cambiar.
      Hablaba de voces, de sombras que susurraban en la oscuridad, de una presencia
      que la segu\xEDa incluso cuando estaba sola.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 3447704002560
    m_Localized: "Nadie le crey\xF3. Ni siquiera yo.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 3616445046784
    m_Localized: "Hasta que una noche, mi tel\xE9fono vibra. Es un mensaje de ella...\r\n"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
