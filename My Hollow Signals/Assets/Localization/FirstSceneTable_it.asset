  m_Name: FirstSceneTable_it
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 2d79eebcfc96f414e9609c2c18ae53bf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 109973348352
    m_Localized: Spazio
    m_Metadata:
      m_Items: []
  - m_Id: 2655215427584
    m_Localized: Continua
    m_Metadata:
      m_Items: []
  - m_Id: 2726715727872
    m_Localized: "Dicono che i legami di sangue non si spezzano mai\u2026 ma i nostri
      sono sempre stati diversi."
    m_Metadata:
      m_Items: []
  - m_Id: 2862632148992
    m_Localized: "Mia sorella \xE8 nata senza la capacit\xE0 di vedere il mondo,
      eppure sembrava sempre comprenderlo meglio di me."
    m_Metadata:
      m_Items: []
  - m_Id: 3133424803840
    m_Localized: "Era colei che riusciva a calmarmi nei miei momenti peggiori, colei
      che parlava di cose che non poteva vedere ma descriveva come se fossero l\xEC.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 3307396145152
    m_Localized: 'Col passare degli anni, le sue parole cominciarono a cambiare.
      Parlava di voci, di ombre che sussurravano nel buio, di una presenza che la
      seguiva anche quando era sola.

'
    m_Metadata:
      m_Items: []
  - m_Id: 3447704002560
    m_Localized: 'Nessuno le credeva. Nemmeno io.

'
    m_Metadata:
      m_Items: []
  - m_Id: 3616445046784
    m_Localized: "Finch\xE9 una notte, il mio telefono vibra. \xC8 un messaggio da
      lei\u2026\r\n"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
